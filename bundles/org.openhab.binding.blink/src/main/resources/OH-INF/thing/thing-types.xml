<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0" bindingId="blink"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<bridge-type id="account">
		<label>Blink Account</label>
		<description>Blink Account Information</description>

		<representation-property>email</representation-property>

		<config-description>
			<parameter name="email" type="text" required="true">
				<context>email</context>
				<label>E-mail</label>
				<description>Blink Account E-Mail</description>
			</parameter>
			<parameter name="password" type="text" required="true">
				<context>password</context>
				<label>Password</label>
				<description>Blink Account Password</description>
			</parameter>
			<parameter name="refreshInterval" type="integer" unit="s" min="30">
				<default>120</default>
				<label>Refresh Interval</label>
				<description>Interval the account devices' states are polled, in sec.</description>
			</parameter>
			<parameter name="mfaCode" type="text">
				<label>MFA Code</label>
				<description>MultiFactor / Two Factor Authentication Code sent to your device after initial login attempt. Once
					received, type it here and then click Save to complete the login.</description>
			</parameter>
		</config-description>
	</bridge-type>

	<thing-type id="camera">
		<supported-bridge-type-refs>
			<bridge-type-ref id="account"/>
		</supported-bridge-type-refs>

		<label>Blink Security Camera</label>
		<description>Blink Security Camera</description>
		<category>Camera</category>

		<channels>
			<channel id="motiondetection" typeId="motiondetection"/>
			<channel id="motionTriggered" typeId="motionTriggered"/>
			<channel id="battery" typeId="system.low-battery"/>
			<channel id='batteryVoltage' typeId="batteryVoltage"/>
			<channel id="temperature" typeId="temperature"/>
			<channel id="setThumbnail" typeId="setThumbnail">
				<autoUpdatePolicy>veto</autoUpdatePolicy>
			</channel>
			<channel id="getThumbnail" typeId="thumbnail"/>
			<channel id="motionThumbnail" typeId="motionThumbnail"/>
			<channel id="lastUpdated" typeId="lastUpdated"/>
			<channel id="highUsageRate" typeId="highUsageRate"/>
			<channel id="wifiLevel" typeId="wifiLevel"/>
			<channel id="wifiRssi" typeId="wifiRssi"/>
			<channel id="lfrLevel" typeId="lfrLevel"/>
			<channel id="lfrRssi" typeId="lfrRssi"/>
		</channels>

		<properties>
			<property name="vendor">Blink</property>
		</properties>

		<representation-property>cameraId</representation-property>

		<config-description>
			<parameter name="cameraId" type="integer" required="true" readOnly="true">
				<label>ID</label>
				<description>Internal ID of camera.</description>
			</parameter>
			<parameter name="networkId" type="integer" required="true" readOnly="true">
				<label>ID</label>
				<description>Internal ID of network.</description>
			</parameter>
			<parameter name="cameraType" type="text" required="true" readOnly="true">
				<label>Type</label>
				<description>Camera type, either CAMERA, DOORBELL, or OWL (for blink minis).
				</description>
			</parameter>
		</config-description>

	</thing-type>

	<thing-type id="network">
		<supported-bridge-type-refs>
			<bridge-type-ref id="account"/>
		</supported-bridge-type-refs>

		<label>Blink Security Network</label>
		<description>A Blink Security Network is defined by a Blink Sync Module, which has a number of cameras connected to
			it.</description>

		<channels>
			<channel id="armed" typeId="armed"/>
		</channels>

		<properties>
			<property name="vendor">Blink</property>
		</properties>

		<representation-property>networkId</representation-property>

		<config-description>
			<parameter name="networkId" type="integer" required="true" readOnly="true">
				<label>ID</label>
				<description>Internal ID of network.</description>
			</parameter>
		</config-description>

	</thing-type>

	<channel-type id="motiondetection">
		<item-type>Switch</item-type>
		<label>Motion Detection</label>
		<description>Motion Detection Status</description>
		<category>Camera</category>
		<tags>
			<tag>Switch</tag>
		</tags>
	</channel-type>

	<channel-type id="setThumbnail">
		<item-type>Switch</item-type>
		<label>Create Thumbnail</label>
		<description>Save current snapshot as thumbnail</description>
		<category>Camera</category>
		<tags>
			<tag>Switch</tag>
		</tags>
	</channel-type>

	<channel-type id="thumbnail">
		<item-type>Image</item-type>
		<label>Saved Thumbnail</label>
		<description>Camera's saved thumbnail, as seen in the Blink App</description>
		<category>Camera</category>
	</channel-type>

	<channel-type id="motionThumbnail">
		<item-type>Image</item-type>
		<label>Recent Motion Thumbnail</label>
		<description>Thumbnail from the most recent motion video capture</description>
		<category>Camera</category>
	</channel-type>

	<channel-type id="temperature">
		<item-type>Number:Temperature</item-type>
		<label>Temperature</label>
		<description>Temperature measured by Camera</description>
		<category>Temperature</category>
		<tags>
			<tag>Temperature</tag>
		</tags>
		<state pattern="%.1f °F" readOnly="true"/>
	</channel-type>

	<channel-type id="armed">
		<item-type>Switch</item-type>
		<label>Armed</label>
		<description>Network armed (start recording/reporting motion events for enabled cameras)</description>
		<tags>
			<tag>Switch</tag>
		</tags>
	</channel-type>

	<channel-type id="motionTriggered">
		<kind>trigger</kind>
		<label>Motion Triggered</label>
		<description>When motion is detected by the camera, this channel is triggered</description>
		<category>Motion</category>
		<tags>
			<tag>Motion</tag>
			<tag>Alarm</tag>
		</tags>
		<state readOnly="true"></state>
	</channel-type>

	<channel-type id="batteryVoltage">
		<item-type>Number:ElectricPotential</item-type>
		<label>Battery Voltage</label>
		<description>The current voltage for this camera's power source (i.e. batteries or USB power)</description>
		<category>Battery</category>
		<state pattern="%.2f V" min="1.3" max="1.8" readOnly="true"/>
	</channel-type>

	<channel-type id="lastUpdated" advanced="true">
		<item-type>DateTime</item-type>
		<label>Last Communication</label>
		<description>The date and time when this camera last communicated with the Blink Servers</description>
		<category>time</category>
		<tags>
			<tag>Timestamp</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="highUsageRate" advanced="true">
		<item-type>Switch</item-type>
		<label>High Usage Rate Detected</label>
		<description>Is this camera experiencing a high rate of usage?</description>
		<tags>
			<tag>Switch</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="wifiLevel" advanced="true">
		<item-type>Number</item-type>
		<label>WiFi Signal Strength Level</label>
		<description>A 1-5 level rating of the signal strength for data sent from your WiFi router</description>
		<category>Network</category>
		<tags>
			<tag>SignalStrength</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="wifiRssi" advanced="true">
		<item-type>Number</item-type>
		<label>WiFi RSSI</label>
		<description>Received Signal Strength Indicator for data sent from your WiFi router, in dBm</description>
		<category>Network</category>
		<tags>
			<tag>RSSI</tag>
		</tags>
		<state pattern="%d dBm" readOnly="true"/>
	</channel-type>

	<channel-type id="lfrLevel" advanced="true">
		<item-type>Number</item-type>
		<label>Sync Module Signal Strength Level</label>
		<description>A 1-5 level rating of the signal strength for data sent from your Sync Module</description>
		<category>Network</category>
		<tags>
			<tag>SignalStrength</tag>
		</tags>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="lfrRssi" advanced="true">
		<item-type>Number</item-type>
		<label>Sync Module RSSI</label>
		<description>Received Signal Strength Indicator for data sent from your Sync Module, in dBm</description>
		<category>Network</category>
		<tags>
			<tag>RSSI</tag>
		</tags>
		<state pattern="%d dBm" readOnly="true"/>
	</channel-type>

</thing:thing-descriptions>
